#!/usr/bin/env bash
#
# One entry point for operating the bridge, so nothing needs a virtualenv
# activated or a launchctl label remembered.
#
#   vta doctor | sync --dry-run | bootstrap | config     the CLI
#   vta start | stop | restart | status | logs | health  the services
#
# Anything unrecognised is passed straight through to the CLI.

set -euo pipefail

LABEL_PREFIX="com.xerxesb.voice-to-anylist"
BRIDGE_LABEL="${LABEL_PREFIX}.bridge"
SIDECAR_LABEL="${LABEL_PREFIX}.sidecar"

STATE_DIR="${VTA_STATE_DIR:-$HOME/Library/Application Support/voice-to-anylist}"
RUNTIME_DIR="$STATE_DIR/runtime"
LOG_DIR="$STATE_DIR/logs"
CLI="$RUNTIME_DIR/venv/bin/voice-to-anylist"
PORT="${HTTP_PORT:-8080}"

[ -x "$CLI" ] || {
  printf 'not installed: %s is missing. Run deploy/macos/install.sh\n' "$CLI" >&2
  exit 1
}

# Sidecar first on the way up so the bridge's opening cycle has something to
# talk to, and last on the way down.
UP=("$SIDECAR_LABEL" "$BRIDGE_LABEL")
DOWN=("$BRIDGE_LABEL" "$SIDECAR_LABEL")

case "${1:-}" in
  start)   for l in "${UP[@]}"; do launchctl kickstart "gui/$UID/$l"; done
           printf 'started\n' ;;
  stop)    for l in "${DOWN[@]}"; do launchctl kill SIGTERM "gui/$UID/$l" 2>/dev/null || true; done
           printf 'stopped (launchd will restart them; use uninstall.sh to remove)\n' ;;
  restart) for l in "${UP[@]}"; do launchctl kickstart -k "gui/$UID/$l"; done
           printf 'restarted\n' ;;
  status)  curl -fsS "http://127.0.0.1:$PORT/status" 2>/dev/null | "$RUNTIME_DIR/venv/bin/python" -m json.tool \
             || printf 'the bridge is not answering on :%s -- try "vta logs"\n' "$PORT" ;;
  health)  curl -s -o /dev/stdout -w '\nHTTP %{http_code}\n' "http://127.0.0.1:$PORT/healthz" ;;
  logs)    tail -n 50 -F "$LOG_DIR/bridge.log" "$LOG_DIR/sidecar.log" ;;
  jobs)    for l in "${UP[@]}"; do
             printf '%s: %s\n' "$l" \
               "$(launchctl print "gui/$UID/$l" 2>/dev/null | awk '/state = /{print $3; exit}' || echo 'not loaded')"
           done ;;
  "")      "$CLI" --help ;;
  # Run from the state directory: that is where .env lives, and
  # pydantic-settings resolves it relative to the working directory.
  *)       cd "$STATE_DIR" && exec "$CLI" "$@" ;;
esac
