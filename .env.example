# Copy to the state directory as .env, or let deploy/macos/install.sh seed it.
#
# Values are left empty deliberately.  A placeholder here is worse than
# nothing: the bridge would read it as configured, try to authenticate with
# it, and report an auth failure rather than telling you it needs setting up.

# -- Google Keep -------------------------------------------------------------
# The account whose "Shopping list" note Assistant writes into.
GOOGLE_EMAIL=
# Obtain with `vta bootstrap`. Begins with aas_et/ and behaves like a
# logged-in device on the account: it grants access to every note in that
# account's Keep, and its scope cannot be narrowed. Treat it as a password.
GOOGLE_MASTER_TOKEN=
KEEP_NOTE_TITLE=Shopping list

# -- AnyList -----------------------------------------------------------------
ANYLIST_EMAIL=
ANYLIST_PASSWORD=
# Must match the list name exactly. `vta doctor` prints every list on the
# account so the spelling can be copied rather than guessed.
ANYLIST_LIST=Grocery

# -- Behaviour ---------------------------------------------------------------
# How often the bridge reads the Keep note.  Reads of AnyList are answered
# from the sidecar's copy in memory, so this does not set how often AnyList
# is downloaded; the settings below do.
POLL_INTERVAL_SECONDS=20

# Every AnyList download is the whole account, and too many got this account's
# syncing suspended for an hour.  The sidecar downloads again only when
# AnyList pushes a change, or as a backstop.  Leave these empty for the
# defaults, shown here; `vta status` reports the count under anylist_downloads.
#   Never more often than this, however many pushes arrive (default 60):
ANYLIST_MIN_REFRESH_SECONDS=
#   Backstop for a missed push (default 900):
ANYLIST_MAX_AGE_SECONDS=
#   Backstop while AnyList's websocket is down (default 300):
ANYLIST_DISCONNECTED_MAX_AGE_SECONDS=
#   Hard ceiling in any rolling hour, surviving restarts (default 40):
ANYLIST_HOURLY_DOWNLOAD_BUDGET=
# Plan without writing anything, logging what it would do. Leave this on
# until `vta sync --dry-run` shows you a plan you are happy with.
DRY_RUN=true

# -- Optional ----------------------------------------------------------------
# Faults that need a human: auth failures, a tripped guard. Any ntfy-compatible
# endpoint works, e.g. https://ntfy.sh/your-secret-topic
# The master token dying is the expected long-run failure, and the symptom --
# items quietly not arriving -- otherwise goes unnoticed for a week.
ALERT_WEBHOOK_URL=

# Announced when a voice add puts something new on the list, at low priority.
# Keep this on a *different* topic from ALERT_WEBHOOK_URL: a channel that pings
# for every banana is one you stop reading, and then you miss the alert above.
ACTIVITY_WEBHOOK_URL=
