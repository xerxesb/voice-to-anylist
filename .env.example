# Copy to the state directory as .env, or let deploy/macos/install.sh seed it.
#
# Values are left empty deliberately.  A placeholder here is worse than
# nothing: the bridge would read it as configured, try to authenticate with
# it, and report an auth failure rather than telling you it needs setting up.

# -- Google Keep -------------------------------------------------------------
# The account whose "Shopping list" note Assistant writes into.
GOOGLE_EMAIL=
# Obtain with `vta bootstrap`. Begins with aas_et/ and behaves like a
# logged-in device on the account: it grants access to every note in that
# account's Keep, and its scope cannot be narrowed. Treat it as a password.
GOOGLE_MASTER_TOKEN=
KEEP_NOTE_TITLE=Shopping list

# -- AnyList -----------------------------------------------------------------
ANYLIST_EMAIL=
ANYLIST_PASSWORD=
# Must match the list name exactly. `vta doctor` prints every list on the
# account so the spelling can be copied rather than guessed.
ANYLIST_LIST=Grocery

# -- Behaviour ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=20
# Plan without writing anything, logging what it would do. Leave this on
# until `vta sync --dry-run` shows you a plan you are happy with.
DRY_RUN=true

# -- Optional ----------------------------------------------------------------
# POSTed a plain-text body when auth fails or the guard trips. Any
# ntfy-compatible endpoint works, e.g. https://ntfy.sh/your-secret-topic
# The master token dying is the expected long-run failure, and the symptom --
# items quietly not arriving -- otherwise goes unnoticed for a week.
ALERT_WEBHOOK_URL=
