# Google Keep -- the account whose "Shopping list" note Assistant writes into.
# Get the master token with: voice-to-anylist bootstrap
GOOGLE_EMAIL=you@gmail.com
GOOGLE_MASTER_TOKEN=aas_et/...
KEEP_NOTE_TITLE=Shopping list

# AnyList
ANYLIST_EMAIL=you@example.com
ANYLIST_PASSWORD=...
ANYLIST_LIST=Grocery

# Behaviour
POLL_INTERVAL_SECONDS=20
# Plan without writing anything. Run like this until you trust it.
DRY_RUN=false

# Optional: POSTed a plain-text body when auth fails or the guard trips.
# Any ntfy-compatible endpoint works, e.g. https://ntfy.sh/your-secret-topic
ALERT_WEBHOOK_URL=
